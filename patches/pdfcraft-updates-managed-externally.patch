+/// Whether this build gets its updates from a package manager: `PDFCRAFT_UPDATES_MANAGED_EXTERNALLY`
+/// set to anything when it was compiled.
+fn updates_managed_externally(build_setting: Option<&str>) -> bool {
+    build_setting.is_some()
+}
+
+#[cfg(test)]
+#[test]
+fn updates_are_managed_externally_only_when_the_build_says_so() {
+    assert!(!updates_managed_externally(None));
+    assert!(updates_managed_externally(Some("1")));
+    assert!(updates_managed_externally(Some("")), "set to anything, even empty");
+}
